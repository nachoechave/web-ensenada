<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="https://localhost:18443" force="true"/>
        <server name="APP_URL" value="https://localhost:18443"/>
        <env name="APP_KEY" value="base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=" force="true"/>
        <server name="APP_KEY" value="base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI="/>
        <env name="AUTH_LOCAL_ONLY" value="true" force="true"/>
        <server name="AUTH_LOCAL_ONLY" value="true"/>
        <env name="AUTH_JWT_SECRET" value="synthetic-test-only-ensenada-signing-key-123456789" force="true"/>
        <server name="AUTH_JWT_SECRET" value="synthetic-test-only-ensenada-signing-key-123456789"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <server name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <env name="AUTH_DISPOSABLE_MYSQL" value="false" force="true"/>
        <server name="AUTH_DISPOSABLE_MYSQL" value="false"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <server name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <server name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
