        <env name="TELESCOPE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
