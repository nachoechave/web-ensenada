{
    admin off
    auto_https disable_redirects
    skip_install_trust
}
https://localhost:18443 {
    tls internal
    @upload path /api/admin/archivos/noticias /api/admin/archivos/sitio /api/admin/hacienda/*/archivos /api/admin/proveedores/documentos
    request_body @upload {
        max_size 31MiB
    }
    @laravel path /api/* /uploads/noticias/* /uploads/sitio/* /uploads/hacienda/* /uploads/proveedores/*
    handle @laravel {
        reverse_proxy app:8000
    }
    handle {
        respond 404
    }
    handle_errors 413 {
        respond "" 413
    }
}
