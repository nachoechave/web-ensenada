<?xml version="1.0" encoding="UTF-8"?>
<policymap>
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="memory" value="48MiB"/>
  <policy domain="resource" name="map" value="0"/>
  <policy domain="resource" name="disk" value="192MiB"/>
  <policy domain="resource" name="width" value="65535"/>
  <policy domain="resource" name="height" value="65535"/>
