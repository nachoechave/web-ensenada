APP_NAME="Web Ensenada"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://prueba.ensenada.gov.ar
APP_KEY=

# The API remains disabled while the private activation marker is absent.
AUTH_LOCAL_ONLY=false
AUTH_DISPOSABLE_MYSQL=false
AUTH_JWT_SECRET=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_COLLATION=utf8mb4_unicode_520_ci
DB_DATABASE=ensenada_web
DB_USERNAME=ensenada_web_app
DB_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
QUEUE_CONNECTION=sync
